# ---- Featherlog production configuration -----------------------------------
# Generate secrets with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me
AUTH_SECRET=change-me-to-a-long-random-string

# Public URL of the app. With Caddy, set APP_DOMAIN to the same host.
APP_URL=https://changelog.example.com
APP_DOMAIN=changelog.example.com
ACME_EMAIL=you@example.com
# Optional separate hosts (must also be routed to the app):
# PUBLIC_URL=https://updates.example.com
# WIDGET_URL=https://widget.example.com

# open | invite | closed — the first user can always sign up.
SIGNUP_MODE=invite

# Email (any SMTP provider: Resend, Postmark, SES…)
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM="Featherlog <changelog@example.com>"

# File storage: local (volume) or s3 (Cloudflare R2, AWS S3, MinIO…)
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=featherlog
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://files.example.com

# Google sign-in (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# inline (default): jobs run in the web process. separate: run a second container with `worker`.
WORKER_MODE=inline
LOG_LEVEL=info

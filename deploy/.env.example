# ---- Featherlog production configuration -----------------------------------
# Minimal setup = one server running app + Postgres + Caddy. Everything below "Optional"
# can stay commented out. Generate secrets with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me
AUTH_SECRET=change-me-to-a-long-random-string

# Public URL. With the bundled Caddy (USE_CADDY=1), APP_DOMAIN gets an automatic HTTPS certificate.
APP_URL=https://changelog.example.com
APP_DOMAIN=changelog.example.com
ACME_EMAIL=you@example.com
USE_CADDY=1

# Who can sign up: open | invite | closed (the first user can always sign up).
SIGNUP_MODE=invite
# Company instance: people with these email domains can sign up and auto-join a workspace.
# Requires proven addresses: Google sign-in (below) or SMTP verification.
# ALLOWED_EMAIL_DOMAINS=example.com
# AUTO_JOIN_WORKSPACE=example

# ---- Optional ---------------------------------------------------------------
# Email. Without it: invitations are shared as links from the dashboard, and magic-link
# sign-in / password reset emails are disabled.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="Featherlog <changelog@example.com>"

# Google sign-in (combine with ALLOWED_EMAIL_DOMAINS for a passwordless company instance)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Separate hosts for the public page / widget (must also be routed to the app)
# PUBLIC_URL=https://updates.example.com
# WIDGET_URL=https://widget.example.com

# File storage: local volume (default) or any S3-compatible bucket
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<region>.digitaloceanspaces.com
# S3_REGION=auto
# S3_BUCKET=featherlog
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://files.example.com

# Backups (deploy/backup.sh runs daily via cron): dumps are always kept on the server.
# BACKUP_KEEP_DAYS=14
# Encrypt with age (public key only on the server):
# BACKUP_AGE_RECIPIENT=age1...
# Also upload off-site to S3-compatible storage:
# BACKUP_S3_BUCKET=featherlog-backups
# BACKUP_S3_ENDPOINT=https://<region>.digitaloceanspaces.com
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=

# inline (default): background jobs run in the web process. separate: run a `worker` container.
WORKER_MODE=inline
LOG_LEVEL=info

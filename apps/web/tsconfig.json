{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] },
    "allowJs": false,
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "src",
    "scripts",
    "test",
    "worker.ts",
    ".next/types/**/*.ts",
    "*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}

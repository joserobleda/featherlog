# --- Required -------------------------------------------------------------
DATABASE_URL=postgres://featherlog:featherlog@localhost:5442/featherlog
# Long random string (openssl rand -base64 32). Required in production.
AUTH_SECRET=change-me-dev-secret-change-me-dev-secret
# Public URL of the app (dashboard, API, MCP).
APP_URL=http://localhost:3100

# --- Optional -------------------------------------------------------------
# Public changelog pages and widget host. Default to APP_URL.
# PUBLIC_URL=https://changelog.example.com
# WIDGET_URL=https://widget.example.com

# Sign-ups: open | invite (only via invitations) | closed
SIGNUP_MODE=open

# File storage: local | s3
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=featherlog
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://files.example.com

# Email (SMTP). Mailpit in development: smtp://localhost:1025
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Featherlog <no-reply@localhost>"

# Google sign-in (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Background jobs: inline (in the web process) | separate (run `worker`) | off
WORKER_MODE=inline
# Apply database migrations when the server starts
MIGRATE_ON_START=true
LOG_LEVEL=info

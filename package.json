{
  "name": "featherlog",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@9.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @featherlog/web dev",
    "build": "pnpm -r --filter './packages/*' --if-present build && pnpm --filter @featherlog/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @featherlog/db generate",
    "db:migrate": "pnpm --filter @featherlog/db migrate",
    "db:seed": "pnpm --filter @featherlog/web seed",
    "services": "docker compose -f docker/compose.dev.yml up -d"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}